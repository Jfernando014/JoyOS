<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Automotive Fullscreen Dark Theme (Prevents boot white-flicker on head units) -->
    <style name="Theme.JoyOS" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/joyos_bg_canvas</item>
        <item name="android:colorBackground">@color/joyos_bg_canvas</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/joyos_bg_canvas</item>
        <item name="android:navigationBarColor">@color/joyos_bg_canvas</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
